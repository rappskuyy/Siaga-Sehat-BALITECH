# Used by `npx wrangler dev` / `npx vite preview` (Cloudflare local dev).
# Copy this file to .dev.vars and fill in your real key(s). Never commit .dev.vars.
# For production, set them with:
#   npx wrangler secret put AI_PROVIDER
#   npx wrangler secret put OPENAI_API_KEY
#   npx wrangler secret put GEMINI_API_KEY

# Pilih provider AI untuk semua fitur: "openai", "gemini", atau "koboillm"
AI_PROVIDER=openai

# KoboiLLM Config
KOBOILLM_BASE_URL=https://api.koboillm.com/v1
KOBOILLM_API_KEY=
KOBOILLM_MODEL=gemini-2.5-flash

# Isi salah satu sesuai AI_PROVIDER yang dipilih di atas
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Maps & Places API
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Supabase (WAJIB untuk fitur login, register, profil, dan riwayat scan)
# Ambil dari Project Settings > API di dashboard Supabase.
# Catatan: variabel berprefix VITE_ akan otomatis di-inject ke client oleh Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

